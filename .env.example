# ============================
# Pinnacles Farm Backend Config
# ============================

PORT=3001

# JWT Secret — change this to a long random string in production
JWT_SECRET=pinnacles_farm_secret_2026_change_me

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Pinnacles2026!

# Farm contact info
WA_NUMBER=2347078210834
FARM_EMAIL=agribusiness@pinnaclescentre.com

# ── Email Notifications (optional but recommended) ────────────
# Used to send admin email alerts when a new order is placed.
# For Gmail: enable 2-Step Verification, then generate an App Password at
# https://myaccount.google.com/apppasswords (select "Mail" + "Other")
SMTP_USER=agribusiness@pinnaclescentre.com
SMTP_PASS=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ─────────────────────────────────────────────────────────────
# NOTE: For Vercel deployment, add all the above as Environment
# Variables in your Vercel project settings (Settings → Environment Variables)
